{
  "name": "turnikman",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TurnikMan — пародийный 3D-симулятор турника: физика, 4 карты, скины",
  "scripts": {
    "serve": "node scripts/serve.cjs",
    "test": "node test/physics.test.mjs && node test/content.test.mjs && node test/headless.mjs",
